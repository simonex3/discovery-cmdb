# ============================================================
# Discovery CMDB - Environment Configuration
# Copy this file to .env and adjust values
# ============================================================

# --- Database ---
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=cmdb_secret_change_me

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_super_secret_key_in_production_please

# --- Network Discovery ---
NETWORK_RANGE=192.168.178.0/24
DISCOVERY_INTERVAL_MINUTES=60
HEALTH_CHECK_INTERVAL_MINUTES=5
AUTO_DISCOVERY_ENABLED=true

# --- Application ---
FRONTEND_PORT=8085
CORS_ORIGINS=["*"]

# --- Setup ---
# Set to true after initial setup wizard is completed
SETUP_COMPLETED=false
SEED_SAMPLE_DATA=true
